{
  "name": "@local/neon-5cms-theme",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Neon 5cm/s (霓虹秒速五厘米) third-party theme for the DSH Web UI, registered through the official theme extension point",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-theme"
      ]
    }
  },
  "license": "MIT",
  "author": "26huitailang"
}
